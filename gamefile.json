        "sectionsDict": {
          "Hand": {
            "isHidden": "opponent-only",
            "height": "MEDIUM",
            "alignment": "CENTER",
            "displayedTitle": "Mão"
          },
          "Deck": {
            "isHidden": "yes",
            "height": "MEDIUM",
            "alignment": "DECK",
            "displayedTitle": "Império"
          },
          "Discard": {
            "isHidden": "opponent-only",
            "height": "MEDIUM",
            "alignment": "DECK",
            "displayedTitle": "Descanso"
          },
          "Remove": {
            "isHidden": "no",
            "height": "SMALL",
            "alignment": "DECK",
            "displayedTitle": "Desterro"
          },
          "Territorio": {
            "isHidden": "no",
            "height": "DEFAULT",
            "alignment": "CENTER",
            "displayedTitle": "Território",
            "isHorizontalAllowed": true,
            "keepTappedNewTurn": false,
            "logWhenPlayed": true
          },
          "Reserva": {
            "type": "custom",
            "isHidden": "no",
            "height": "SMALL",
            "alignment": "NONE",
            "displayedTitle": "Reserva & Hegemonia",
            "isShared": false,
            "defaultValue": {
              "roxo": 0,
              "vermelho": 0,
              "azul": 0,
              "verde": 0,
              "ouro": 0,
              "hegemonia": 0
            },
            "blueprint": {
              "type": "div",
              "props": {
                "className": "reserva-panel"
              },
              "children": [
                {
                  "type": "div",
                  "props": {
                    "className": "reserva-row reserva-hegemonia"
                  },
                  "children": [
                    "Hegemonia",
                    {
                      "type": "input-number",
                      "props": {
                        "value": "{{ game.data.Reserva.hegemonia }}"
                      },
                      "onChange": "game.data.Reserva.hegemonia = Number(value); functions.chatLog(`Hegemonia agora: ${game.data.Reserva.hegemonia}`)"
                    }
                  ]
                },
                {
                  "type": "div",
                  "props": {
                    "className": "reserva-row"
                  },
                  "children": [
                    {
                      "type": "button",
                      "children": "Abrir Mercado",
                      "onClick": "await setupMarket()"
                    }
                  ]
                },
                {
                  "type": "div",
                  "props": {
                    "className": "reserva-row"
                  },
                  "children": [
                    {
                      "type": "button",
                      "children": "Repor Mercado",
                      "onClick": "await replenishMarket()"
                    }
                  ]
                },
                {
                  "type": "div",
                  "props": {
                    "className": "reserva-row"
                  },
                  "children": [
                    {
                      "type": "button",
                      "children": "Avançar Mercado (Renovação)",
                      "onClick": "await advanceMarket()"
                    }
                  ]
                },
                {
                  "type": "div",
                  "props": {
                    "className": "reserva-row"
                  },
                  "children": [
                    "Roxo (Helênica)",
                    {
                      "type": "input-number",
                      "props": {
                        "value": "{{ game.data.Reserva.roxo }}"
                      },
                      "onChange": "game.data.Reserva.roxo = Number(value)"
                    }
                  ]
                },
                {
                  "type": "div",
                  "props": {
                    "className": "reserva-row"
                  },
                  "children": [
                    "Vermelho (Latina)",
                    {
                      "type": "input-number",
                      "props": {
                        "value": "{{ game.data.Reserva.vermelho }}"
                      },
                      "onChange": "game.data.Reserva.vermelho = Number(value)"
                    }
                  ]
                },
                {
                  "type": "div",
                  "props": {
                    "className": "reserva-row"
                  },
                  "children": [
                    "Azul (Fenícia)",
                    {
                      "type": "input-number",
                      "props": {
                        "value": "{{ game.data.Reserva.azul }}"
                      },
                      "onChange": "game.data.Reserva.azul = Number(value)"
                    }
                  ]
                },
                {
                  "type": "div",
                  "props": {
                    "className": "reserva-row"
                  },
                  "children": [
                    "Verde (Celta)",
                    {
                      "type": "input-number",
                      "props": {
                        "value": "{{ game.data.Reserva.verde }}"
                      },
                      "onChange": "game.data.Reserva.verde = Number(value)"
                    }
                  ]
                },
                {
                  "type": "div",
                  "props": {
                    "className": "reserva-row"
                  },
                  "children": [
                    "Ouro",
                    {
                      "type": "input-number",
                      "props": {
                        "value": "{{ game.data.Reserva.ouro }}"
                      },
                      "onChange": "game.data.Reserva.ouro = Number(value)"
                    }
                  ]
                }
              ]
            },
            "events": {
              "onPlayersSideboardClosed": "await placeCapital();",
              "onPlayersMulligan": "await placeCapital();",
              "onPlayersReady": "await placeCapital();",
              "onNewTurn": "await placeCapital();",
              "onCardsUpdate": "await placeCapital();"
            }
          },
